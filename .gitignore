# Local session notes (not for version control)
CHANGES_SUMMARY.md
WEBOTS_PHASE*.txt

# Runtime episode logs (regenerated each run; keep data/ folder via .gitkeep)
data/*
!data/.gitkeep
!data/README.md
vm_simulation_system/data/*
!vm_simulation_system/data/.gitkeep

# Curriculum state (written each run; do not commit)
vm_simulation_system/config/curriculum_state.json
vm_simulation_system/config/curriculum_state_robot2.json

# Local analysis and exports (not for version control)
docs/
analysis/output/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/

# Virtual environments
venv/
.venv/
env/

# ML checkpoints (large binaries — copy locally, do not commit)
host_gpu_system/models/*.pth

# IDE / OS
.vscode/
.idea/
.cursor/
*.swdoc
~$*
.DS_Store
Thumbs.db

# macOS resource forks (from USB / network copy)
._*

# Debug / session scratch
debug-*.log
**/client_vision_debug_*.jpg
host_gpu_system/ai_vision_debug_*

# Webots editor state and cache (regenerated)
*.wbproj
**/.wbproj
**/*.cache

# Webots / env extract scratch
_env_extract/

# Full Webots project from Box (too large; see README — not on GitHub)
updated_world/

# Local world copy with machine-specific paths (canonical world is updated_world/ from Box)
vm_simulation_system/Webots/worlds/

# Large Webots texture dataset — copy locally from VM or team share
**/textures/Dataset/*.jpg
**/textures/Dataset/*.jpeg
**/textures/Dataset/*.png
**/textures/Dataset/*.tar.gz
**/textures/Dataset.zip
**/textures/Dataset.tar.xz
**/Environmentnewww.zip
!**/textures/Dataset/Put images in this folder.txt
